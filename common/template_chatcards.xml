<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- Small pill-shaped keyword chip; set text from Lua -->
	<template name="cc_chip">
		<stringcontrol>
			<anchored height="20" />
			<font>cc_chip</font>
			<center />
			<readonly />
			<script>
				function setText(sText, bRed)
					if (sText or "") == "" then
						setVisible(false);
						return;
					end
					setFrame(bRed and "cc_chip_red" or "cc_chip_gold", 8, 3, 8, 3);
					setValue(sText);
					-- Rough width fit for placeholder art; refine once in-app
					setAnchoredWidth(18 + (#sText * 7));
					setVisible(true);
				end
			</script>
		</stringcontrol>
	</template>

	<!-- Portrait box shown at the top-left of cards: gold frame + icon layer.
	     Set via ChatCardsManager.setCardPortrait, together with the token
	     layer below (cc_portrait_token must be declared before it). -->
	<template name="cc_portrait">
		<genericcontrol>
			<anchored width="44" height="44" />
			<frame name="cc_portraitframe" />
		</genericcontrol>
	</template>

	<!-- Token layer: renders NPC token/picture assets under the frame -->
	<template name="cc_portrait_token">
		<tokencontrol>
			<anchored width="36" height="36" />
			<invisible />
		</tokencontrol>
	</template>
</root>
