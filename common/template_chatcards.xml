<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- Small pill-shaped keyword chip (14px tall); set text from Lua.
	     The label is a measured text widget so the pill width fits the
	     content with a fixed 6px margin on each side. -->
	<template name="cc_chip">
		<genericcontrol>
			<anchored height="14" />
			<script>
				local _wLabel = nil;
				function setText(sText, bAccent)
					if (sText or "") == "" then
						setVisible(false);
						-- collapse so empty chip rows don't inflate the card
						setAnchoredHeight(0);
						setAnchoredWidth(0);
						return;
					end
					setFrame(bAccent and "cc_chip_red" or "cc_chip_gold");
					if not _wLabel then
						_wLabel = addTextWidget({ font = "cc_chip", text = sText, position = "center" });
					else
						_wLabel.setText(sText);
					end
					local nTextWidth = _wLabel.getSize();
					setAnchoredWidth((nTextWidth or 24) + 12);
					setAnchoredHeight(14);
					setVisible(true);
				end
			</script>
		</genericcontrol>
	</template>

	<!-- Portrait box shown at the top-left of cards, as three stacked
	     layers (declare in this order so the border draws on top):
	     cc_portrait_token (NPC token/picture art), cc_portrait_icon
	     (PC portrait / GM badge / "?" icons), cc_portrait_frame
	     (border-only graphic). The avatar layers are 40x40, matching the
	     44x44 frame's square inner area (2px border) — anchor them at
	     +2,+2 relative to the frame position.
	     Set via ChatCardsManager.setCardPortrait(porticon, tokenview, t). -->
	<template name="cc_portrait_token">
		<tokencontrol>
			<anchored width="40" height="40" />
			<invisible />
		</tokencontrol>
	</template>

	<template name="cc_portrait_icon">
		<genericcontrol>
			<anchored width="40" height="40" />
		</genericcontrol>
	</template>

	<!-- Top avatar layer: no border graphic any more, but still the host for
	     the corner-cover widget that rounds the avatar (see
	     ChatCardsManager.setCardPortrait). -->
	<template name="cc_portrait_frame">
		<genericcontrol>
			<anchored width="44" height="44" />
		</genericcontrol>
	</template>
</root>
