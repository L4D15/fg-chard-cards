<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- Small pill-shaped keyword chip; set text from Lua -->
	<template name="cc_chip">
		<stringcontrol>
			<anchored height="20" />
			<font>cc_chip</font>
			<center />
			<readonly />
			<script>
				function setText(sText, bRed)
					if (sText or "") == "" then
						setVisible(false);
						-- collapse so empty chip rows don't inflate the card
						setAnchoredHeight(0);
						setAnchoredWidth(0);
						return;
					end
					setFrame(bRed and "cc_chip_red" or "cc_chip_gold", 8, 3, 8, 3);
					setValue(sText);
					-- Rough width fit for placeholder art; refine once in-app
					setAnchoredWidth(18 + (#sText * 7));
					setAnchoredHeight(20);
					setVisible(true);
				end
			</script>
		</stringcontrol>
	</template>

	<!-- Portrait box shown at the top-left of cards, as three stacked
	     layers (declare in this order so the border draws on top):
	     cc_portrait_token (NPC token/picture art), cc_portrait_icon
	     (PC portrait / GM badge / "?" icons), cc_portrait_frame
	     (border-only graphic). The avatar layers are 40x40, matching the
	     44x44 frame's square inner area (2px border) — anchor them at
	     +2,+2 relative to the frame position.
	     Set via ChatCardsManager.setCardPortrait(porticon, tokenview, t). -->
	<template name="cc_portrait_token">
		<tokencontrol>
			<anchored width="40" height="40" />
			<invisible />
		</tokencontrol>
	</template>

	<template name="cc_portrait_icon">
		<genericcontrol>
			<anchored width="40" height="40" />
		</genericcontrol>
	</template>

	<template name="cc_portrait_frame">
		<genericcontrol>
			<anchored width="44" height="44" />
			<frame name="cc_portraitframe" />
		</genericcontrol>
	</template>
</root>
