<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- One-line gold banner: "Turn: X", "Y takes 7 damage", system messages -->
	<windowclass name="chatcard_banner">
		<margins control="0,0,0,8" />
		<frame>cc_banner</frame>
		<script>
			function setData(t)
				text.setValue(t.sText or "");
			end
		</script>
		<sheetdata>
			<stringcontrol name="text">
				<anchored>
					<top offset="8" />
					<left offset="14" />
					<right offset="-14" />
				</anchored>
				<font>cc_bannertext</font>
				<multilinespacing>18</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Speech / emote / OOC: portrait, name, subtitle, framed text body -->
	<windowclass name="chatcard_speech">
		<frame>cc_card</frame>
		<script>
			function setData(t)
				name.setValue(t.sName or "");
				subtitle.setValue(t.sSub or "");
				text.setValue(t.sText or "");
				ChatCardsManager.setCardPortrait(porticon, tokenview, t);
			end
		</script>
		<sheetdata>
			<cc_portrait_token name="tokenview">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_token>
			<cc_portrait_icon name="porticon">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_icon>
			<cc_portrait_frame name="portraitframe">
				<anchored position="insidetopleft" offset="5,5" />
			</cc_portrait_frame>
			<!-- Header row: no background frame (the card art carries the
			     styling); inset by the art's 5px shadow. -->
			<genericcontrol name="namebar">
				<anchored height="26">
					<top offset="5" />
					<left offset="49" />
					<right offset="-5" />
				</anchored>
			</genericcontrol>
			<stringcontrol name="name">
				<anchored to="namebar" position="insidetopleft" offset="10,3" />
				<font>cc_name</font>
				<readonly />
			</stringcontrol>
			<stringcontrol name="subtitle">
				<anchored to="namebar" position="belowleft" offset="10,2" height="18" />
				<font>cc_subtitle</font>
				<readonly />
			</stringcontrol>
			<stringcontrol name="text">
				<anchored>
					<top parent="subtitle" anchor="bottom" offset="6" />
					<left offset="15" />
					<right offset="-15" />
				</anchored>
				<font>cc_body</font>
				<frame name="cc_panel" offset="8,6,8,6" />
				<multilinespacing>19</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="17" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Action card: attack / damage / generic roll. Left column carries the
	     actor name, player name, roll type, body lines and chips; the result
	     area owns the right side with the dice, total and outcome.
	     Controls are declared so that every anchor points at an earlier one. -->
	<windowclass name="chatcard_action">
		<frame>cc_card</frame>
		<script file="scripts/chatcard_action.lua" />
		<sheetdata>
			<cc_portrait_token name="tokenview">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_token>
			<cc_portrait_icon name="porticon">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_icon>
			<cc_portrait_frame name="portraitframe">
				<anchored position="insidetopleft" offset="5,5" />
			</cc_portrait_frame>

			<!-- Result area: full inner height of the card's right side. Its
			     height is computed in Lua, since bottom anchors do not
			     resolve inside list windows. -->
			<genericcontrol name="resultbox">
				<anchored width="110" height="84">
					<top offset="5" />
					<right offset="-5" />
				</anchored>
			</genericcontrol>

			<!-- Name block: actor name, player name tight beneath it, then
			     the roll type. No background frame — the card art styles it. -->
			<genericcontrol name="namebar">
				<anchored height="20">
					<top offset="5" />
					<left offset="49" />
					<right parent="resultbox" anchor="left" offset="-4" />
				</anchored>
			</genericcontrol>
			<stringcontrol name="name">
				<anchored to="namebar" position="insidetopleft" offset="10,2" />
				<font>cc_name</font>
				<readonly />
			</stringcontrol>
			<stringcontrol name="subtitle">
				<anchored to="namebar" position="belowleft" offset="10,0" height="15" />
				<font>cc_subtitle</font>
				<readonly />
			</stringcontrol>
			<!-- Roll type ("Melee Attack", "Check: Dexterity") -->
			<stringcontrol name="title">
				<anchored height="15">
					<top parent="subtitle" anchor="bottom" offset="0" />
					<left parent="namebar" anchor="left" offset="10" />
					<right parent="resultbox" anchor="left" offset="-4" />
				</anchored>
				<font>cc_headertitle</font>
				<readonly />
			</stringcontrol>

			<!-- Individual die results, as Lua widgets -->
			<genericcontrol name="diceresults">
				<anchored height="0">
					<top parent="resultbox" anchor="top" offset="2" />
					<left parent="resultbox" anchor="left" offset="4" />
					<right parent="resultbox" anchor="right" offset="-4" />
				</anchored>
			</genericcontrol>
			<stringcontrol name="total">
				<anchored height="30">
					<top parent="diceresults" anchor="bottom" offset="0" />
					<left parent="resultbox" anchor="left" offset="0" />
					<right parent="resultbox" anchor="right" offset="0" />
				</anchored>
				<font>cc_total</font>
				<center />
				<readonly />
			</stringcontrol>
			<stringcontrol name="outcome">
				<anchored height="16">
					<top parent="total" anchor="bottom" offset="0" />
					<left parent="resultbox" anchor="left" offset="0" />
					<right parent="resultbox" anchor="right" offset="0" />
				</anchored>
				<font>cc_success</font>
				<center />
				<readonly />
			</stringcontrol>

			<!-- Body lines, left of the result box; filled from Lua with a
			     bold "Label:" widget and a regular value widget -->
			<genericcontrol name="line1">
				<anchored height="16">
					<top parent="title" anchor="bottom" offset="0" />
					<left offset="17" />
					<right parent="resultbox" anchor="left" offset="-8" />
				</anchored>
			</genericcontrol>
			<genericcontrol name="line2">
				<anchored height="16">
					<top parent="line1" anchor="bottom" offset="2" />
					<left offset="17" />
					<right parent="resultbox" anchor="left" offset="-8" />
				</anchored>
			</genericcontrol>

			<!-- Keyword chips -->
			<cc_chip name="chip1">
				<anchored>
					<top parent="line2" anchor="bottom" offset="2" />
					<left offset="17" />
				</anchored>
			</cc_chip>
			<cc_chip name="chip2">
				<anchored>
					<top parent="line2" anchor="bottom" offset="2" />
					<left parent="chip1" anchor="right" offset="6" />
				</anchored>
			</cc_chip>
			<cc_chip name="chip3">
				<anchored>
					<top parent="line2" anchor="bottom" offset="2" />
					<left parent="chip2" anchor="right" offset="6" />
				</anchored>
			</cc_chip>

			<genericcontrol name="sizer">
				<anchored to="chip1" position="belowleft" height="9" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>
</root>
