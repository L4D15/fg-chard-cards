<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- Full-width text cards. Apply banners ("takes N damage") and story
	     text share this layout but differ in background and font, and a
	     windowclass frame is static, so they are separate classes rather
	     than one with overrides. -->
	<windowclass name="chatcard_system">
		<frame>cc_system_card</frame>
		<script>
			function setData(t)
				text.setValue(t.sText or "");
			end
		</script>
		<sheetdata>
			<stringcontrol name="text">
				<anchored>
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<font>cc_bannertext</font>
				<multilinespacing>18</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Effect applied/expired: its own card art, with the names and the effect
	     name in bold inside the sentence. A string control carries one font, so
	     the sentence is a generic control filled with per-word text widgets
	     (ChatCardsManager.setRichText). The effect's rules text sits under it in
	     a label of its own, in one (italic) font, so that one stays a string
	     control and wraps on its own. -->
	<windowclass name="chatcard_effect">
		<frame>cc_effect_card</frame>
		<script file="scripts/chatcard_effect.lua" />
		<sheetdata>
			<cc_rich_sentence name="sentence">
				<anchored height="18">
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
			</cc_rich_sentence>
			<stringcontrol name="logic">
				<anchored>
					<top parent="sentence" anchor="bottom" offset="1" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<font>cc_effectlogic</font>
				<multilinespacing>17</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="logic" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Hope / fear economy notices (Daggerheart): one sentence on the
	     resource's own card art — gold for hope, dark indigo for fear. Two
	     classes for one layout (a windowclass frame is static); the shared
	     script renders the fear card's sentence in the light fonts. -->
	<windowclass name="chatcard_hope">
		<frame>cc_card_hope</frame>
		<script file="scripts/chatcard_resource.lua" />
		<sheetdata>
			<cc_rich_sentence name="sentence">
				<anchored height="18">
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
			</cc_rich_sentence>
			<genericcontrol name="sizer">
				<anchored to="sentence" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>
	<!-- HP / stress tracker notices (Daggerheart), same sentence shape on
	     the system card: hit points and stress are bookkeeping, not
	     economy, so they read as background next to the hope/fear art. -->
	<windowclass name="chatcard_resource_system">
		<frame>cc_system_card</frame>
		<script file="scripts/chatcard_resource.lua" />
		<sheetdata>
			<cc_rich_sentence name="sentence">
				<anchored height="18">
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
			</cc_rich_sentence>
			<genericcontrol name="sizer">
				<anchored to="sentence" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<windowclass name="chatcard_fear">
		<frame>cc_card_fear</frame>
		<script file="scripts/chatcard_resource.lua" />
		<sheetdata>
			<cc_rich_sentence name="sentence">
				<anchored height="18">
					<top offset="8" />
					<left offset="17" />
					<right offset="-40" />
				</anchored>
			</cc_rich_sentence>
			<!-- The GM prompt's bank-a-fear button ("X has rolled with fear"):
			     the ruleset's own gain-fear tile; shown by setData only when
			     the card carries sPrompt, and only the GM ever holds one of
			     those. Daggerheart-only art is safe here — no other system
			     sends "fear" cards, so the class never instantiates
			     elsewhere. -->
			<buttoncontrol name="applyfear">
				<anchored width="22" height="22">
					<top offset="6" />
					<right offset="-10" />
				</anchored>
				<icon normal="button_action_heal_fear" pressed="button_action_heal_fear_down" />
				<tooltip text="The GM gains 1 Fear" />
				<invisible />
				<script>
					function onButtonPress()
						window.onFearApply();
						return true;
					end
				</script>
			</buttoncontrol>
			<genericcontrol name="sizer">
				<anchored to="sentence" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Power use / spell cast: the roll cards' header (portrait, actor name,
	     player name, then the power's name in the title slot, opening its
	     record), the power's action rows right below, and its description
	     folded at the bottom. On the standard card background (cc_card, like
	     the roll cards): it is a player action rather than engine chatter. -->
	<windowclass name="chatcard_power">
		<frame>cc_card</frame>
		<script file="scripts/chatcard_power.lua" />
		<sheetdata>
			<cc_portrait_token name="tokenview">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_token>
			<cc_portrait_icon name="porticon">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_icon>
			<cc_portrait_frame name="portraitframe">
				<anchored position="insidetopleft" offset="5,5" />
			</cc_portrait_frame>

			<!-- Name block, as on the action card: actor name, player name
			     tight beneath it, then the power's name in the title slot. -->
			<genericcontrol name="namebar">
				<anchored height="16">
					<top offset="5" />
					<left offset="49" />
					<right offset="-17" />
				</anchored>
			</genericcontrol>
			<cc_name_link name="name">
				<anchored to="namebar" position="insidetopleft" offset="10,2" />
			</cc_name_link>
			<stringcontrol name="subtitle">
				<anchored to="namebar" position="belowleft" offset="10,0" height="15" />
				<font>cc_subtitle</font>
				<readonly />
			</stringcontrol>
			<!-- The power's name; a link to its record where it resolves. -->
			<cc_name_link name="title">
				<anchored height="15">
					<top parent="subtitle" anchor="bottom" offset="0" />
					<left parent="namebar" anchor="left" offset="10" />
					<right offset="-17" />
				</anchored>
				<font>cc_headertitle</font>
			</cc_name_link>

			<!-- The power's action rows (attack/save/damage/heal/effect...),
			     one per line: button, description, and the roll results
			     inline after it — all as widgets on one control with click
			     hit-testing, since cards are not database-bound windows and
			     the sheet's action list (one button control per action
			     node) cannot be reused here. -->
			<genericcontrol name="actionbar">
				<anchored height="0">
					<top parent="title" anchor="bottom" offset="6" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<script>
					-- Claim the press so the release lands here too.
					function onClickDown()
						return true;
					end
					function onClickRelease(nButton, x, y)
						return window.onActionClick(nButton, x, y);
					end
					-- Dragging a row's button carries its action, like the
					-- sheet's buttons: drop an attack on a token to roll
					-- against it, a save on targets, damage to apply it.
					function onDragStart(nButton, x, y, draginfo)
						return window.onActionDrag(nButton, x, y, draginfo);
					end
					function onHoverUpdate(x, y)
						window.onActionHover(x, y);
					end
				</script>
			</genericcontrol>
			<!-- Fold toggle for the description: a link-styled line the window
			     script drives ("Show description" / "Hide description"). -->
			<stringcontrol name="desctoggle">
				<anchored height="15">
					<top parent="actionbar" anchor="bottom" offset="3" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<font>cc_foldtoggle</font>
				<center />
				<readonly />
				<script>
					local HOVER_COLOR = "FF3B2A12";
					-- Matches cc_foldtoggle in graphics_chatcards.xml.
					local NORMAL_COLOR = "FF79756C";
					function onClickDown()
						if window.hasDescription() then
							return true;
						end
					end
					function onClickRelease(nButton)
						if nButton == 1 then
							window.toggleDescription();
							return true;
						end
					end
					function onHover(bOver)
						if not window.hasDescription() then
							return;
						end
						setHoverCursor(bOver and "hand" or "arrow");
						setColor(bOver and HOVER_COLOR or NORMAL_COLOR);
					end
				</script>
			</stringcontrol>
			<!-- Description body, as rich text (one plain segment): a generic
			     control never autosizes, so the fold's height is set
			     explicitly in both states — an empty stringcontrol keeps a
			     one-line intrinsic height that broke the folded spacing.
			     A cc_rich_sentence, so its layout events drive the reflow
			     (window.renderSentence) now that the header is plain
			     controls. -->
			<cc_rich_sentence name="desc">
				<anchored height="0">
					<top parent="desctoggle" anchor="bottom" offset="0" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
			</cc_rich_sentence>
			<!-- 8px bottom pad in both states: the folded desc is exactly 0
			     high, the expanded one exactly its lines. -->
			<genericcontrol name="sizer">
				<anchored to="desc" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Round breaks: the same card as chatcard_system, centred, so a new round
	     reads as a divider between the turns above and below it. -->
	<windowclass name="chatcard_round">
		<frame>cc_system_card</frame>
		<script>
			function setData(t)
				text.setValue(t.sText or "");
			end
		</script>
		<sheetdata>
			<stringcontrol name="text">
				<anchored>
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<font>cc_bannertext</font>
				<multilinespacing>18</multilinespacing>
				<center />
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Engine/system notices (SystemMessage errors, extension announcements,
	     turn and effect chatter): no background frame — the text sits directly
	     on the chat box — with the message's own icon, when it carries one,
	     leading the first line. The icon slot collapses when empty so
	     iconless text lands on the same 17px inset as the cards. -->
	<windowclass name="chatcard_notice">
		<script>
			local ICON_SIZE = 18;
			function setData(t)
				text.setValue(t.sText or "");
				if (t.sIcon or "") ~= "" then
					noticeicon.setAnchoredWidth(ICON_SIZE);
					noticeicon.addBitmapWidget({
						icon = t.sIcon,
						position = "topleft",
						x = ICON_SIZE / 2, y = ICON_SIZE / 2,
						w = ICON_SIZE, h = ICON_SIZE,
					});
				end
			end
		</script>
		<sheetdata>
			<!-- width 1, not 0: degenerate sizes can drop a control out of the
			     anchor layout (see the action card's boxpad note). -->
			<genericcontrol name="noticeicon">
				<anchored width="1" height="18">
					<top offset="4" />
					<left offset="11" />
				</anchored>
			</genericcontrol>
			<stringcontrol name="text">
				<anchored>
					<top offset="5" />
					<left parent="noticeicon" anchor="right" offset="5" />
					<right offset="-17" />
				</anchored>
				<font>cc_notice</font>
				<multilinespacing>17</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="5" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- A record link dropped into the chat, like the native chat's link
	     line: the class link icon (a linkcontrol, so the engine picks the
	     icon and opens the record on click) and the record's name, which
	     opens it too through the manager's control-link machinery. -->
	<windowclass name="chatcard_link">
		<script>
			function onClose()
				ChatCardsManager.releaseControlState(name);
			end
			function setData(t)
				local sClass = t.sClass or "";
				local sRecord = t.sRecord or "";
				link.setValue(sClass, sRecord);
				name.setValue(t.sName or "");
				if (sClass ~= "") and (sRecord ~= "") then
					-- Restore colour must match the control's font (cc_body).
					ChatCardsManager.setControlLink(name, sClass, sRecord, "FF1A1A1A");
				end
			end
		</script>
		<sheetdata>
			<linkcontrol name="link">
				<anchored width="20" height="20">
					<top offset="3" />
					<left offset="10" />
				</anchored>
				<readonly />
			</linkcontrol>
			<cc_name_link name="name">
				<anchored height="20">
					<top offset="5" />
					<left parent="link" anchor="right" offset="6" />
					<right offset="-17" />
				</anchored>
				<font>cc_body</font>
			</cc_name_link>
			<genericcontrol name="sizer">
				<anchored to="link" position="belowleft" height="4" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Story / narration: the standard card background, italic text. -->
	<windowclass name="chatcard_story">
		<frame>cc_card</frame>
		<script>
			function setData(t)
				text.setValue(t.sText or "");
			end
		</script>
		<sheetdata>
			<stringcontrol name="text">
				<anchored>
					<top offset="8" />
					<left offset="17" />
					<right offset="-17" />
				</anchored>
				<font>cc_story</font>
				<multilinespacing>18</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="8" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Speech / emote / OOC: portrait, name, subtitle, framed text body -->
	<windowclass name="chatcard_speech">
		<frame>cc_card</frame>
		<script>
			function setData(t)
				name.setValue(t.sName or "");
				ChatCardsManager.setActorNameLink(name, t.sActorNode);
				subtitle.setValue(t.sSub or "");
				text.setValue(t.sText or "");
				ChatCardsManager.setCardPortrait(porticon, tokenview, portraitframe, t);
			end
			-- No weak tables in FG's sandbox: release the name link state.
			function onClose()
				ChatCardsManager.releaseControlState(name);
			end
		</script>
		<sheetdata>
			<cc_portrait_token name="tokenview">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_token>
			<cc_portrait_icon name="porticon">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_icon>
			<cc_portrait_frame name="portraitframe">
				<anchored position="insidetopleft" offset="5,5" />
			</cc_portrait_frame>
			<!-- Header row: no background frame (the card art carries the
			     styling); inset by the art's 5px shadow. -->
			<genericcontrol name="namebar">
				<anchored height="16">
					<top offset="5" />
					<left offset="49" />
					<right offset="-5" />
				</anchored>
			</genericcontrol>
			<cc_name_link name="name">
				<anchored to="namebar" position="insidetopleft" offset="10,2" />
			</cc_name_link>
			<stringcontrol name="subtitle">
				<anchored to="namebar" position="belowleft" offset="10,0" height="15" />
				<font>cc_subtitle</font>
				<readonly />
			</stringcontrol>
			<!-- Speech bubble. Anchored to the avatar's bottom because the tail
			     points up at it: the frame extends 12px above this control, 6 of
			     which are the tail, so the bubble's top edge lands just below
			     the avatar. Its other three edges sit exactly on the card
			     art's body edges (frame reaches 8px sideways and 6px below
			     this control, the card art is inset 5px), so at the bottom
			     the bubble's own border is the card's border. -->
			<stringcontrol name="text">
				<anchored>
					<top parent="portraitframe" anchor="bottom" offset="14" />
					<left offset="13" />
					<right offset="-13" />
				</anchored>
				<font>cc_body</font>
				<frame name="cc_speak_area" offset="8,12,8,6" />
				<multilinespacing>19</multilinespacing>
				<readonly />
			</stringcontrol>
			<genericcontrol name="sizer">
				<anchored to="text" position="belowleft" height="11" width="1" />
			</genericcontrol>
		</sheetdata>
	</windowclass>

	<!-- Action card: attack / damage / generic roll. Left column carries the
	     actor name, player name, roll type, body lines and chips; the result
	     area owns the right side with the dice, total and outcome.
	     Controls are declared so that every anchor points at an earlier one. -->
	<windowclass name="chatcard_action">
		<frame>cc_card</frame>
		<script file="scripts/chatcard_action.lua" />
		<sheetdata>
			<cc_portrait_token name="tokenview">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_token>
			<cc_portrait_icon name="porticon">
				<anchored position="insidetopleft" offset="7,7" />
			</cc_portrait_icon>
			<cc_portrait_frame name="portraitframe">
				<anchored position="insidetopleft" offset="5,5" />
			</cc_portrait_frame>

			<!-- Result area: full inner height of the card's right side. Its
			     height is computed in Lua, since bottom anchors do not
			     resolve inside list windows. The whole area is a drag source
			     for the rolled result (damage/heal cards; see onResultDrag),
			     so the controls stacked on it delegate their drags too. -->
			<genericcontrol name="resultbox">
				<anchored width="110" height="84">
					<top offset="5" />
					<right offset="-5" />
				</anchored>
				<script>
					function onDragStart(nButton, x, y, draginfo)
						return window.onResultDrag(draginfo);
					end
				</script>
			</genericcontrol>

			<!-- Name block: actor name, player name tight beneath it, then
			     the roll type. No background frame — the card art styles it. -->
			<genericcontrol name="namebar">
				<anchored height="16">
					<top offset="5" />
					<left offset="49" />
					<right parent="resultbox" anchor="left" offset="-4" />
				</anchored>
			</genericcontrol>
			<cc_name_link name="name">
				<anchored to="namebar" position="insidetopleft" offset="10,2" />
			</cc_name_link>
			<stringcontrol name="subtitle">
				<anchored to="namebar" position="belowleft" offset="10,0" height="15" />
				<font>cc_subtitle</font>
				<readonly />
			</stringcontrol>
			<!-- Roll type ("Melee Attack", "Check: Dexterity") -->
			<stringcontrol name="title">
				<anchored height="15">
					<top parent="subtitle" anchor="bottom" offset="0" />
					<left parent="namebar" anchor="left" offset="10" />
					<right parent="resultbox" anchor="left" offset="-4" />
				</anchored>
				<font>cc_headertitle</font>
				<readonly />
			</stringcontrol>

			<!-- Spacer that vertically centres the result contents: its height
			     is computed in Lua from the box's free space. Draws nothing
			     (no frame or icon) but must NOT be <invisible />, or it stops
			     taking part in the anchor layout — same as the sizers. -->
			<genericcontrol name="boxpad">
				<anchored width="1" height="4">
					<top parent="resultbox" anchor="top" offset="0" />
					<left parent="resultbox" anchor="left" offset="0" />
				</anchored>
			</genericcontrol>
			<!-- Individual die results, as Lua widgets -->
			<genericcontrol name="diceresults">
				<anchored height="0">
					<top parent="boxpad" anchor="bottom" offset="0" />
					<left parent="resultbox" anchor="left" offset="4" />
					<right parent="resultbox" anchor="right" offset="-4" />
				</anchored>
				<script>
					function onDragStart(nButton, x, y, draginfo)
						return window.onResultDrag(draginfo);
					end
				</script>
			</genericcontrol>
			<stringcontrol name="total">
				<anchored height="30">
					<top parent="diceresults" anchor="bottom" offset="0" />
					<left parent="resultbox" anchor="left" offset="0" />
					<right parent="resultbox" anchor="right" offset="0" />
				</anchored>
				<font>cc_total</font>
				<center />
				<readonly />
				<script>
					function onDragStart(nButton, x, y, draginfo)
						return window.onResultDrag(draginfo);
					end
				</script>
			</stringcontrol>
			<stringcontrol name="outcome">
				<anchored height="16">
					<top parent="total" anchor="bottom" offset="-4" />
					<left parent="resultbox" anchor="left" offset="0" />
					<right parent="resultbox" anchor="right" offset="0" />
				</anchored>
				<font>cc_success</font>
				<center />
				<readonly />
				<script>
					function onDragStart(nButton, x, y, draginfo)
						return window.onResultDrag(draginfo);
					end
				</script>
			</stringcontrol>

			<!-- Body lines, left of the result box; filled from Lua with a
			     bold "Label:" widget and a regular value widget -->
			<genericcontrol name="line1">
				<anchored height="16">
					<top parent="title" anchor="bottom" offset="4" />
					<left offset="17" />
					<right parent="resultbox" anchor="left" offset="-8" />
				</anchored>
			</genericcontrol>
			<genericcontrol name="line2">
				<anchored height="16">
					<top parent="line1" anchor="bottom" offset="2" />
					<left offset="17" />
					<right parent="resultbox" anchor="left" offset="-8" />
				</anchored>
			</genericcontrol>

			<!-- What the roll drew (table rolls): one "Result: ..." line per
			     entry, rich text so the entry can link its record. Collapsed
			     (height 0, zero top offset) on cards without results, so the
			     chips sit where they always did. -->
			<cc_rich_sentence name="results">
				<anchored height="0">
					<top parent="line2" anchor="bottom" offset="0" />
					<left offset="17" />
					<right parent="resultbox" anchor="left" offset="-8" />
				</anchored>
			</cc_rich_sentence>

			<!-- Keyword chips -->
			<cc_chip name="chip1">
				<anchored>
					<top parent="results" anchor="bottom" offset="2" />
					<left offset="17" />
				</anchored>
			</cc_chip>
			<cc_chip name="chip2">
				<anchored>
					<top parent="results" anchor="bottom" offset="2" />
					<left parent="chip1" anchor="right" offset="6" />
				</anchored>
			</cc_chip>
			<cc_chip name="chip3">
				<anchored>
					<top parent="results" anchor="bottom" offset="2" />
					<left parent="chip2" anchor="right" offset="6" />
