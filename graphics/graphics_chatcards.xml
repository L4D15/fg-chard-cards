<?xml version="1.0" encoding="iso-8859-1"?>
<root>
	<!-- ===== FRAMES (placeholder 9-slice art; swap the PNGs to restyle) ===== -->
	<!-- cc_card / cc_banner include an 8px transparent gutter at the bottom
	     of the bitmap (inside the bottom 9-slice band): windowclass frames
	     stretch over the window margins, so inter-card spacing lives in
	     the art. Keep the gutter when replacing these graphics. -->
	<framedef name="cc_card">
		<bitmap file="graphics/frames/cc_card.png" />
		<offset>12,12,12,20</offset>
	</framedef>
	<framedef name="cc_header">
		<bitmap file="graphics/frames/cc_header.png" />
		<offset>8,6,8,6</offset>
	</framedef>
	<framedef name="cc_panel">
		<bitmap file="graphics/frames/cc_panel.png" />
		<offset>8,8,8,8</offset>
	</framedef>
	<framedef name="cc_resultbox">
		<bitmap file="graphics/frames/cc_resultbox.png" />
		<offset>8,8,8,8</offset>
	</framedef>
	<framedef name="cc_resultheader">
		<bitmap file="graphics/frames/cc_resultheader.png" />
		<offset>6,5,6,5</offset>
	</framedef>
	<framedef name="cc_chip_red">
		<bitmap file="graphics/frames/cc_chip_red.png" />
		<offset>10,6,10,6</offset>
	</framedef>
	<framedef name="cc_chip_gold">
		<bitmap file="graphics/frames/cc_chip_gold.png" />
		<offset>10,6,10,6</offset>
	</framedef>
	<framedef name="cc_banner">
		<bitmap file="graphics/frames/cc_banner.png" />
		<offset>12,10,12,18</offset>
	</framedef>
	<framedef name="cc_portraitframe">
		<bitmap file="graphics/frames/cc_portraitframe.png" />
		<offset>6,6,6,6</offset>
	</framedef>

	<!-- ===== ICONS ===== -->
	<icon name="cc_portrait_gm" file="graphics/icons/cc_portrait_gm.png" />
	<icon name="cc_portrait_unknown" file="graphics/icons/cc_portrait_unknown.png" />

	<!-- Die result glyphs (native-chat-style black silhouettes) -->
	<icon name="cc_die_d4" file="graphics/icons/cc_die_d4.png" />
	<icon name="cc_die_d6" file="graphics/icons/cc_die_d6.png" />
	<icon name="cc_die_d8" file="graphics/icons/cc_die_d8.png" />
	<icon name="cc_die_d10" file="graphics/icons/cc_die_d10.png" />
	<icon name="cc_die_d12" file="graphics/icons/cc_die_d12.png" />
	<icon name="cc_die_d20" file="graphics/icons/cc_die_d20.png" />

	<!-- Custom portrait set: the engine composites each PC identity's
	     portrait with these layers into "portrait_<identity>_ccard" icons.
	     Transparent base (no ring), full-size rounded mask -> full-bleed
	     portraits clipped to the card frame's corner radius. -->
	<icon name="cc_portrait_base" file="graphics/icons/cc_portrait_base.png" />
	<icon name="cc_portrait_mask" file="graphics/icons/cc_portrait_mask.png" />
	<portraitset name="ccard">
		<base>cc_portrait_base</base>
		<mask>cc_portrait_mask</mask>
	</portraitset>

	<!-- ===== FONTS ===== -->
	<font name="cc_name">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="17" />
		<color value="#3B2A12" />
	</font>
	<font name="cc_headertitle">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="14" />
		<color value="#FFFFFF" />
	</font>
	<font name="cc_subtitle">
		<ttf file="graphics/fonts/NotoSans-Italic.ttf" name="Noto Sans Italic" size="13" />
		<color value="#8A7340" />
	</font>
	<font name="cc_body">
		<ttf file="graphics/fonts/NotoSans-Regular.ttf" name="Noto Sans" size="14" />
		<color value="#1A1A1A" />
	</font>
	<font name="cc_bodybold">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="14" />
		<color value="#1A1A1A" />
	</font>
	<font name="cc_chip">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="12" />
		<color value="#FFFFFF" />
	</font>
	<font name="cc_formula">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="13" />
		<color value="#FFFFFF" />
	</font>
	<font name="cc_total">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="26" />
		<color value="#222222" />
	</font>
	<font name="cc_success">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="11" />
		<color value="#2E7D32" />
	</font>
	<font name="cc_failure">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="11" />
		<color value="#B22E2E" />
	</font>
	<font name="cc_die">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="12" />
		<color value="#FFFFFF" />
	</font>
	<font name="cc_bannertext">
		<ttf file="graphics/fonts/NotoSans-Bold.ttf" name="Noto Sans Bold" size="14" />
		<color value="#3B2A12" />
	</font>
</root>
