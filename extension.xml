<?xml version="1.0" encoding="iso-8859-1"?>
<root version="4.8" release="0.1">
	<properties>
		<name>ChatCards</name>
		<version>0.1</version>
		<author>Jose Ladislao</author>
		<description>Card-style chat message display (CoreRPG-based rulesets; 5E and Daggerheart adapters included)</description>
		<!-- No <ruleset> block: the launcher matches ruleset tags against the
		     campaign's own ruleset name only — "CoreRPG" would never match a
		     5E campaign — so universal extensions omit the gate instead (the
		     Universal Module / Shops pattern). The code gates itself: the
		     core hooks guard their CoreRPG seams, and system adapters
		     (ChatCards5E) self-gate on the ruleset name. -->
		<loadorder>100</loadorder>
	</properties>

	<announcement text="ChatCards v0.1 loaded" font="emotefont" icon="chat_story" />

	<base>
		<includefile source="graphics/graphics_chatcards.xml" />
		<includefile source="common/template_chatcards.xml" />
		<includefile source="common/windowclass_chatcards.xml" />
		<includefile source="desktop/desktop_chatcards.xml" />

		<script name="ChatCardsManager" file="scripts/manager_chatcards.lua" />
		<script name="ChatCardsCore" file="scripts/chatcards_core.lua" />
		<script name="ChatCards5E" file="scripts/chatcards_5e.lua" />
		<script name="ChatCardsDH" file="scripts/chatcards_dh.lua" />
	</base>
</root>
