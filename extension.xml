<?xml version="1.0" encoding="iso-8859-1"?>
<root version="4.8" release="0.1">
	<properties>
		<name>ChatCards</name>
		<version>0.1</version>
		<author>Jose Ladislao</author>
		<description>Card-style chat message display for 5E</description>
		<ruleset>
			<name>5E</name>
		</ruleset>
		<loadorder>100</loadorder>
	</properties>

	<announcement text="ChatCards v0.1 loaded" font="emotefont" icon="chat_story" />

	<base>
		<includefile source="graphics/graphics_chatcards.xml" />
		<includefile source="common/template_chatcards.xml" />
		<includefile source="common/windowclass_chatcards.xml" />
		<includefile source="desktop/desktop_chatcards.xml" />

		<script name="ChatCardsManager" file="scripts/manager_chatcards.lua" />
		<script name="ChatCards5E" file="scripts/chatcards_5e.lua" />
	</base>
</root>
